node_modules/
.claude/
!.claude/commands/
!.claude/commands/**
!.claude/orchestration-cortextos-node/
# Include template .claude dirs (needed for agent settings.json)
!templates/**/.claude/
!templates/**/.claude/**
dist/
ecosystem.config.js

# User-created org data (not part of the framework)
orgs/
# But community subdirectories ARE part of the framework
!community/
!community/**

# Secrets
.env
!.env.example
templates/*/.env
.cortextos-env

# Agent runtime data
orgs/*/agents/*/memory/
agents/*/local/
agents/*/telegram-images/
agents/*/memory/

# macOS metadata
.DS_Store

# Obsidian vault config (B-local, not for repo)
**/.obsidian/

# Test artifacts
test-results/
*.log
# Spurious directory created when ${APPDATA} env var unexpanded during npm link on Windows
${APPDATA}/

# Knowledge base
knowledge-base/venv/
knowledge-base/__pycache__/
knowledge-base/scripts/__pycache__/
knowledge-base/scripts/_test_clients/__pycache__/
tests/playwright/dashboard-ui.spec.ts

# Local ops docs (personal, not for public repo)
docs/

# Internal developer/planning notes (not for public repo)
KNOWN-ISSUES.md
WINDOWS-IMPLEMENTATION-PLAN.md
WINDOWS-SUPPORT-INVESTIGATION.md
BRAINDUMP*.md
AGENTS.md
dashboard/screenshots/
dashboard/test-*.py
*.onnx

# Public community agent templates may intentionally include their own docs,
# AGENTS.md, memory skill, and scaffold files.
!community/agents/research-agent/
!community/agents/research-agent/**
bus/__pycache__/

# Security: never commit plaintext auth/cookie/session files (2026-06-18 audit fix)
.fb-auth.json
**/.fb-auth.json
*-auth.json
**/*cookies*.json
**/*.session

# sandbox-canary enforcement test scratch (auto-cleaned, never commit)
.sandbox-canary-scratch/

# Python bytecode for release tooling
tools/**/__pycache__/
__pycache__/
*.pyc

# Test run artifacts (wave/item result JSONs written by test harnesses)
tests/.item*-result.json

# Editor/backup strays (e.g. bus/*.bak-skill-router-*)
*.bak-*

# Creator-mining research data (downloaded media, captions; belongs in cortextos-data)
research/
