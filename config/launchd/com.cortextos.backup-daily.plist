<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cortextos.backup-daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/chrisjackson/cortextos/scripts/backup-daily.sh</string>
    </array>

    <!-- Run daily at 23:00 ET (= 03:00 UTC) — matches backup-daily.sh comment -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>23</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/chrisjackson/cortextos/logs/backup/backup-daily.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/chrisjackson/cortextos/logs/backup/backup-daily.err.log</string>

    <!-- Run even if the machine was asleep at scheduled time -->
    <key>KeepAlive</key>
    <false/>

    <!-- Restart on failure, up to 3 times per day -->
    <key>ThrottleInterval</key>
    <integer>28800</integer>
</dict>
</plist>
